# ==============================================================================
# EMPLOYEE MANAGEMENT SYSTEM (EMS) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in your server/ environment directory.
# NEVER commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development # Options: 'development' | 'production' | 'test'

# CORS Allowed Origin: URL of your deployed or local frontend client
# For local development: http://localhost:5173
# For production: https://your-ems-client.vercel.app
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# Local MongoDB instance:
MONGO_URI=mongodb://127.0.0.1:27017/ems_db

# MongoDB Atlas Production (Cloud Cluster):
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/ems_db?retryWrites=true&w=majority&appName=EMSCluster

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & BCRYPT)
# ------------------------------------------------------------------------------
# In production, use a strong cryptographically random 64-character string
# Example generation: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_string_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Rate Limiting configuration (defaults: 300 requests/15m globally, 15 attempts/15m for login)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=15

# ------------------------------------------------------------------------------
# 4. BACKGROUND JOBS & ASYNC WORKERS (INNGEST)
# ------------------------------------------------------------------------------
# Optional keys for Inngest Cloud workflow coordination
INNGEST_EVENT_KEY=local_inngest_key
INNGEST_SIGNING_KEY=local_inngest_signing_key

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATION SERVICE (NODEMAILER / SMTP)
# ------------------------------------------------------------------------------
# For testing, use Mailtrap (https://mailtrap.io) or Ethereal Email
# For production, use SendGrid, Resend, or AWS SES
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=EMS Notifications <no-reply@ems.internal>

# ------------------------------------------------------------------------------
# 6. AI INTELLIGENCE SERVICE LAYER
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_API_KEY=local_ai_service_key_replace_in_production
