PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/ems_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Initial Seed Credentials (Used by seed script - never hardcoded in source)
ADMIN_NAME="Anchal Keshri"
ADMIN_EMAIL="anchal.keshri@ems.corp"
ADMIN_PASSWORD="AdminPassword@2025"

EMPLOYEE_NAME="Sophia Chen"
EMPLOYEE_EMAIL="sophia.chen@ems.corp"
EMPLOYEE_PASSWORD="EmployeePassword@2025"

# Inngest Background Jobs
INNGEST_EVENT_KEY=local_inngest_key
INNGEST_SIGNING_KEY=local_inngest_signing_key

# Nodemailer / SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EMS Support <no-reply@ems.internal>

# AI Service Gateway & LLM Configuration
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_API_KEY=local_ai_service_key
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
